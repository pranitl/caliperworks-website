---
import { gapReviewSources, homeCareReviewLabel, homeCareSampleHref, homeCareSampleLabel } from '../lib/gap-review.js';

interface Props {
  featured?: boolean;
  heading?: string;
  intro?: string;
}

const {
  featured = false,
  heading = 'See what a local SEO audit looks like',
  intro = 'Follow a Scottsdale home-care example from competitor research to the first pages and fixes we would prioritize.',
} = Astro.props;
---

<section id={featured ? 'featured-seo-audit' : undefined} aria-labelledby="seo-audit-feature-title" class="border-b border-slate-200 bg-[#edf4fb] px-6 py-12 md:py-16">
  <div class="mx-auto grid max-w-7xl gap-8 lg:grid-cols-[1.2fr_0.8fr] lg:items-center">
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-blue-800">{featured ? 'Featured resource' : 'Sample local SEO audit'}</p>
      <h2 id="seo-audit-feature-title" class="mt-3 max-w-2xl text-3xl font-semibold leading-tight tracking-[-0.04em] text-slate-950 md:text-5xl">{heading}</h2>
      <p class="mt-4 max-w-2xl text-lg leading-7 text-slate-700">{intro}</p>
      <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-4">
        <a href={homeCareSampleHref} class="rounded-lg bg-blue-700 px-5 py-3 text-sm font-bold text-white transition-colors hover:bg-slate-900">{homeCareSampleLabel}</a>
        <a href={gapReviewSources.homeCare} class="text-sm font-bold text-blue-800 underline underline-offset-4">{homeCareReviewLabel}</a>
      </div>
    </div>
    <div class="rounded-xl border border-slate-300 bg-white p-5 sm:p-6">
      <p class="text-sm font-bold text-slate-950">Inside the Scottsdale audit</p>
      <ul class="mt-3 space-y-2 text-sm leading-6 text-slate-700">
        <li>Five real competitor pages and the questions they answer</li>
        <li>Sample results from Google Search, Maps, and AI answers</li>
        <li>What to publish, what to fix, and how to check progress</li>
      </ul>
      <p class="mt-3 border-t border-slate-200 pt-3 text-xs leading-5 text-slate-600">The competitor research is real. The example agency and its rankings are simulated.</p>
    </div>
  </div>
</section>
